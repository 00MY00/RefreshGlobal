{
  "manifest_version": 1,

  "module": {
    "id": "refresh-global",
    "name": "RefreshGlobal",
    "alias": "refreshglobal",
    "version_source": "module.json",
    "documentation": "docs/INTEROPERABILITY.md"
  },

  "interop": {
    "protocol": "1.0.0",
    "bridge": "Public/js/fs-interop.js",

    "provides": {
      "capabilities": {
        "global-ticket-list": "1.0",
        "global-dashboard": "1.1",
        "saved-views": "1.0",
        "shared-views": "1.0",
        "navigation-origin": "1.0",
        "mail-tags": "1.0",
        "mail-move": "1.0",
        "global-search": { "version": "1.0", "extension": true, "description": "RefreshGlobal extension, not part of the shared protocol yet (search: later, by agreement)" }
      },

      "events": {
        "refreshglobal:view-changed": { "version": "1.0", "schema": "view-changed" },
        "refreshglobal:conversation-opened": { "version": "1.0", "schema": "conversation-origin" },
        "refreshglobal:dashboard-rendered": { "version": "1.0", "schema": "dashboard-rendered" }
      },

      "surfaces": [
        { "surface": "ticket-list", "context": "global-mailboxes", "version": "1.0" },
        { "surface": "dashboard", "context": "global-mailboxes", "version": "1.1" },
        { "surface": "saved-views", "context": "global-mailboxes", "version": "1.0" },
        { "surface": "search", "context": "global-mailboxes", "version": "1.0" }
      ],

      "registrations": {
        "navigation": [
          { "id": "refreshglobal.all-mailboxes", "version": "1.0", "schema": "navigation-entry" }
        ],
        "toolbar": [
          { "id": "refreshglobal.move-to-folder", "version": "1.0", "schema": "toolbar-action" },
          { "id": "refreshglobal.delete-forever", "version": "1.0", "schema": "toolbar-action" }
        ],
        "swipe": [
          { "id": "refreshglobal.move-to-folder", "version": "1.0", "schema": "swipe-action" }
        ]
      },

      "context": {
        "conversation-origin": "1.0"
      },

      "schemas": {
        "module-registration": { "version": "1.0", "file": "docs/interop/schemas/module-registration-1.0.schema.json" },
        "conversation-origin": { "version": "1.0", "file": "docs/interop/schemas/conversation-origin-1.0.schema.json" },
        "view-changed": { "version": "1.0", "file": "docs/interop/schemas/view-changed-1.0.schema.json" },
        "navigation-entry": { "version": "1.0", "file": "docs/interop/schemas/navigation-entry-1.0.schema.json" },
        "toolbar-action": { "version": "1.0", "file": "docs/interop/schemas/toolbar-action-1.0.schema.json" },
        "swipe-action": { "version": "1.0", "file": "docs/interop/schemas/swipe-action-1.0.schema.json" },
        "dashboard-data": { "version": "1.1", "file": "docs/interop/schemas/dashboard-data-1.1.schema.json" },
        "saved-view": { "version": "2.0", "file": "docs/interop/schemas/saved-view-2.0.schema.json" },
        "health": { "version": "1.0", "file": "docs/interop/schemas/health-1.0.schema.json" },
        "search-provider": { "version": "1.0", "file": "docs/interop/schemas/search-provider-1.0.schema.json" },
        "search-results": { "version": "1.0", "file": "docs/interop/schemas/search-results-1.0.schema.json" },
        "navigation-context": { "version": "1.0", "file": "docs/interop/schemas/navigation-context-1.0.schema.json" },
        "conversation-context": { "version": "1.0", "file": "docs/interop/schemas/conversation-context-1.0.schema.json" },
        "dashboard-owner": { "version": "1.0", "file": "docs/interop/schemas/dashboard-owner-1.0.schema.json" },
        "dashboard-rendered": { "version": "1.0", "file": "docs/interop/schemas/dashboard-rendered-1.0.schema.json" },
        "sla-targets": { "version": "1.0", "file": "docs/interop/schemas/sla-targets-1.0.schema.json" }
      },

      "server_hooks": {
        "fsinterop.modules": { "type": "filter", "version": "1.0", "description": "each participating module adds its summary (id, version, protocol, capabilities)" },
        "fsinterop.dashboard.context": { "type": "filter", "version": "1.0", "description": "context of a dashboard about to be computed; other modules may only narrow mailbox_ids" },
        "fsinterop.dashboard.data": { "type": "filter", "version": "1.1", "schema": "dashboard-data", "description": "dashboard figures of a scope; RefreshGlobal answers scope global-mailboxes" },
        "fsinterop.dashboard.owner": { "type": "filter", "version": "1.0", "schema": "dashboard-owner", "description": "module that renders the dashboard of FreeScout's dashboard page for a user (context: page, user_id); RefreshGlobal answers refresh-global when its dashboard of all mailboxes is on; Refresh with the contract then does not render its block" },
        "fsinterop.sla.targets": { "type": "filter", "role": "consumer", "version": "1.0", "schema": "sla-targets", "description": "SLA targets declared by another module (Refresh from its contract version): first_response_hours, resolution_hours; asked by RefreshGlobal, never answered by it" },
        "fsinterop.navigation.context": { "type": "filter", "version": "1.0", "schema": "navigation-context", "description": "context of the page being built; each module claims the surfaces it renders there (owners surface@scope => module id), never overwriting another claim" },
        "fsinterop.conversation.context": { "type": "filter", "version": "1.0", "schema": "conversation-context", "description": "what each module knows about a ticket for a user (args: context, conversation, user); each module adds only modules[<its id>]" },
        "fsinterop.search.providers": { "type": "filter", "version": "1.0", "schema": "search-provider", "extension": true, "description": "RefreshGlobal extension (not in the shared protocol yet): search providers of the modules, [provider id => descriptor]; RefreshGlobal adds refreshglobal.global-search" },
        "fsinterop.search.results": { "type": "filter", "version": "1.0", "schema": "search-results", "extension": true, "description": "RefreshGlobal extension (not in the shared protocol yet): results of a search scope (context: scope, query, limit, user_id, mailbox_ids); RefreshGlobal answers scope global-mailboxes" },
        "refreshglobal.mail_tags": { "type": "filter", "version": "1.0", "description": "origin tags of tickets (docs/api-tags.md)" },
        "refreshglobal.thread_mail_tags": { "type": "filter", "version": "1.0", "description": "origin tags and server folder of e-mails (docs/api-tags.md)" },
        "refreshglobal.mail_tagged": { "type": "action", "version": "1.0", "description": "an e-mail received new origin tags (docs/api-tags.md)" },
        "refreshglobal.mail_moved": { "type": "action", "version": "1.0", "description": "an e-mail was moved to another folder of the mail server (docs/api-tags.md)" }
      },

      "routes": {
        "refreshglobal.search": { "method": "GET", "path": "/refresh-global/search", "version": "1.0", "schema": "search-results", "description": "endpoint of the search provider refreshglobal.global-search (q, limit, mb[]); read-only, the user's rights" }
      },

      "commands": {
        "refreshglobal:health": "health check, read-only (healthCommand of module.json)",
        "refreshglobal:check": "integration checks RG-xxx (Config/integration.php)"
      }
    },

    "consumes": {
      "optional": {
        "refresh": {
          "protocol": ">=1.0.0 <2.0.0",
          "capabilities": {
            "navigation": ">=1.0 <2.0",
            "navigation-context": ">=1.0 <2.0",
            "ticket-toolbar": ">=1.0 <2.0",
            "swipe-actions": ">=1.0 <2.0",
            "conversation-ui": ">=1.0 <2.0",
            "dashboard-handoff": ">=1.0 <2.0"
          }
        }
      }
    }
  },

  "compatibility": {
    "freescout": ">=1.8.0 <1.9.0",
    "php": ">=7.1.0",
    "peers": {
      "refresh": {
        "required": false,
        "supported_versions": ">=1.4.0 <2.0.0",
        "interop_protocol": ">=1.0.0 <2.0.0",
        "fallback": {
          "supported_versions": ">=1.4.0 <1.7.0",
          "mode": "legacy"
        },
        "conflicts": []
      }
    }
  },

  "compatibility_policy": {
    "peer_protocol_mismatch": "degraded",
    "explicit_conflict": "blocked",
    "unknown_peer_version": "warning"
  }
}
