{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/00MY00/RefreshGlobal/blob/main/RefreshGlobal/docs/interop/schemas/swipe-action-1.0.schema.json",
    "title": "Swipe action 1.0",
    "description": "FreeScoutInterop.swipe.register(): an action offered when a ticket of a list is swiped; only the module that owns the list handles the touch events and calls handler(context) with {conversationId, mailboxId}.",
    "type": "object",
    "required": [
        "id",
        "owner",
        "label",
        "direction",
        "handler"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "owner": {
            "type": "string"
        },
        "label": {
            "type": "string"
        },
        "icon": {
            "type": "string"
        },
        "direction": {
            "enum": [
                "left",
                "right"
            ]
        },
        "contexts": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "order": {
            "type": "integer"
        },
        "handler": {
            "description": "function (context) — not serializable"
        }
    }
}
