{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/00MY00/RefreshGlobal/blob/main/RefreshGlobal/docs/interop/schemas/dashboard-rendered-1.0.schema.json",
    "title": "Dashboard rendered 1.0",
    "description": "Browser event refreshglobal:dashboard-rendered: the dashboard of all mailboxes is on the page.",
    "type": "object",
    "required": [
        "schema",
        "source_module",
        "scope"
    ],
    "properties": {
        "schema": {
            "const": "1.0"
        },
        "source_module": {
            "type": "string"
        },
        "scope": {
            "const": "global-mailboxes"
        },
        "placement": {
            "enum": [
                "native",
                "refresh",
                "standalone",
                ""
            ],
            "description": "native: added after Refresh handed it over; refresh: legacy replacement of Refresh's block; standalone: without Refresh"
        }
    }
}
