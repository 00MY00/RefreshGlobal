{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/00MY00/RefreshGlobal/blob/main/RefreshGlobal/docs/interop/schemas/navigation-entry-1.0.schema.json",
    "title": "Navigation entry 1.0",
    "description": "FreeScoutInterop.navigation.register(): an intent of navigation entry; the module that renders the navigation places it.",
    "type": "object",
    "required": [
        "id",
        "owner",
        "label",
        "href"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "owner": {
            "type": "string"
        },
        "label": {
            "type": "string"
        },
        "href": {
            "type": "string"
        },
        "icon": {
            "type": "string",
            "description": "icon name or URL of an SVG"
        },
        "placements": {
            "type": "array",
            "items": {
                "enum": [
                    "desktop-sidebar",
                    "mobile-drawer",
                    "mobile-bottom-bar"
                ]
            }
        },
        "position": {
            "type": "object",
            "properties": {
                "after": {
                    "type": "string"
                },
                "before": {
                    "type": "string"
                }
            }
        },
        "replaces": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "placements": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "active": {
            "type": "boolean"
        },
        "order": {
            "type": "integer"
        }
    }
}
