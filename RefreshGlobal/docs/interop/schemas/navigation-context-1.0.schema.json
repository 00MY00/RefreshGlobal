{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/00MY00/RefreshGlobal/blob/main/RefreshGlobal/docs/interop/schemas/navigation-context-1.0.schema.json",
    "title": "Navigation context 1.0",
    "description": "Server filter fsinterop.navigation.context: the page being built and which module renders which surface on it (context-aware ownership). Listeners only add owners; an existing claim is never overwritten.",
    "type": "object",
    "required": [
        "schema",
        "route",
        "context",
        "owners"
    ],
    "properties": {
        "schema": {
            "const": "1.0"
        },
        "route": {
            "type": "string",
            "description": "route name"
        },
        "context": {
            "enum": [
                "dashboard",
                "mailbox",
                "conversation",
                "global-mailboxes",
                "other"
            ]
        },
        "mailbox_id": {
            "type": [
                "integer",
                "null"
            ]
        },
        "conversation_id": {
            "type": [
                "integer",
                "null"
            ]
        },
        "user_id": {
            "type": "integer"
        },
        "owners": {
            "type": "object",
            "description": "\"surface@scope\" => module id, e.g. \"ticket-list@global-mailboxes\": \"refresh-global\"",
            "propertyNames": {
                "pattern": "^[a-z0-9-]+@[a-z0-9*-]+$"
            },
            "additionalProperties": {
                "type": "string"
            }
        }
    }
}
