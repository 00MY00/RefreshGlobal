{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/00MY00/RefreshGlobal/blob/main/RefreshGlobal/docs/interop/schemas/sla-targets-1.0.schema.json",
    "title": "SLA targets 1.0",
    "description": "Server filter fsinterop.sla.targets: \\Eventy::filter('fsinterop.sla.targets', null, ['schema' => '1.0', 'scope' => 'global-mailboxes', 'user_id' => int]) returns the service-level targets declared by a module (e.g. Refresh), or an empty value.",
    "type": "object",
    "required": [
        "schema",
        "source_module",
        "first_response_hours",
        "resolution_hours"
    ],
    "properties": {
        "schema": {
            "const": "1.0"
        },
        "source_module": {
            "type": "string"
        },
        "first_response_hours": {
            "type": "integer",
            "minimum": 1
        },
        "resolution_hours": {
            "type": "integer",
            "minimum": 1
        }
    }
}
